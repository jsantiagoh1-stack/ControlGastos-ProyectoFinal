<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar ingreso"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etDescripcionIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción (salario, venta, depósito...)"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etMontoIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monto en quetzales (Q)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etFechaIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (AAAA-MM-DD)"
            android:inputType="date"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnGuardarIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar ingreso" />


        <Button
            android:id="@+id/btnEliminarIngreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Eliminar ingreso"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
